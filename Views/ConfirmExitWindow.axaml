<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XMLApp.Views.ConfirmExitWindow"
        Title="Підтвердження виходу"
        Width="420" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#ffffff">

    <Grid Margin="24" RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Завершення роботи"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#1e293b" />
            <TextBlock Text="Чи дійсно ви хочете завершити роботу з програмою?"
                       FontSize="14"
                       Foreground="#475569"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
            <Button Name="YesButton"
                    Content="Так"
                    Width="90"
                    HorizontalContentAlignment="Center"
                    Background="#dc2626"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="YesButton_Click" />
            <Button Name="NoButton"
                    Content="Ні"
                    Width="90"
                    HorizontalContentAlignment="Center"
                    Background="#e2e8f0"
                    Foreground="#1e293b"
                    Click="NoButton_Click" />
        </StackPanel>
    </Grid>
</Window>
